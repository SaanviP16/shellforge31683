#include <ctype.h>
#include <string.h>
#include <stdio.h>
#include "lexer.h"

void lexer(const char *input,
           token_list_t *list)
{
    token_list_init(list);

    int i = 0;


    while(input[i] != '\0')
    {
        /* Skip whitespace */
        if(isspace((unsigned char)input[i]))
        {
            i++;
            continue;
        }

        /* Pipe */
        if(input[i] == '|')
        {
            token_add(list,TOKEN_PIPE,"|");
            i++;
            continue;
        }

        /* Input redirection */
        if(input[i] == '<')
        {
            token_add(list,TOKEN_INPUT,"<");
            i++;
            continue;
        }

        /* Output redirection */
        if(input[i] == '>')
        {
            if(input[i+1] == '>')
            {
                token_add(list,TOKEN_APPEND,">>");
                i += 2;
            }
            else
            {
                token_add(list,TOKEN_OUTPUT,">");
                i++;
            }
            continue;
        }

        /* Background */
        if(input[i] == '&')
        {
            token_add(list,TOKEN_BACKGROUND,"&");
            i++;
            continue;
        }


         /* Build one WORD token */

        char word[MAX_TOKEN_LEN];

        int j = 0;

